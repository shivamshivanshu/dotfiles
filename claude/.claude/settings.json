{
  "env": {
    "EDITOR": "nvim",
    "VISUAL": "nvim",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "defaultMode": "auto",
    "ask": [
      "Bash(git push *)",
      "Bash(git * push)",
      "Bash(git * push *)",
      "Bash(git p *)",
      "Bash(git po *)",
      "Bash(git pow *)",
      "Bash(rtk git push *)",
      "Bash(rtk git * push)",
      "Bash(rtk git * push *)"
    ],
    "additionalDirectories": [
      "~/claude_notes"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/session_start.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/notify.py\" busy",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/notify.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/notify.py\" busy",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/notify.py\" done",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/notify.py\" clear",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "time-reminder@imc-claude-plugins": true,
    "imc-auto-mode@imc-claude-plugins": true,
    "sub-agent-delegator@imc-claude-plugins": false,
    "working-with-git@imc-claude-plugins": true,
    "gerrit@imc-claude-plugins": true,
    "sparing-commenting@imc-claude-plugins": true,
    "teamcity@imc-claude-plugins": true,
    "imc-sandbox@imc-claude-plugins": false,
    "clio@imc-claude-plugins": true
  },
  "outputStyle": "Recall",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "cleanupPeriodDays": 365,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "switchModelsOnFlag": false,
  "teammateMode": "in-process",
  "skillOverrides": {
    "claude:agent-team": "off",
    "claude:autonomous-mode": "off",
    "claude:bazel": "off",
    "claude:codebase-recon": "off",
    "claude:concurrency": "off",
    "claude:cpp": "off",
    "claude:cpp-build": "off",
    "claude:delegation": "off",
    "claude:design-doc": "off",
    "claude:doc-reviewer": "off",
    "claude:fan-n": "off",
    "claude:git": "off",
    "claude:handoff": "off",
    "claude:perf-investigation": "off",
    "claude:python": "off",
    "claude:rtk": "off",
    "claude:session-insight": "off",
    "claude:stochastic-consensus": "off",
    "claude:teacher": "off",
    "claude:working-style": "off"
  }
}
