# paths
for d in "$HOME/.local/bin" "$HOME/bin" "$HOME/.cargo/bin"; do
  [[ -d "$d" && ":$PATH:" != *":$d:"* ]] && PATH="$d:$PATH"
done
export PATH

# Early init that .zshrc.d/* files depend on
autoload -Uz compinit && compinit -C

# source modular configs
if [[ -d ~/.zshrc.d ]]; then
  for rc in ~/.zshrc.d/*(N); do
    [[ -f "$rc" ]] && source "$rc"
  done
  unset rc
fi
