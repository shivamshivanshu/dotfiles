# Work/machine hosts go in ~/.ssh/config.local (untracked). Include is first so it
# can override the Host * defaults (ssh takes the first value seen per keyword).
Include ~/.ssh/config.local

Host *
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%C
    ControlPersist 10m

    ServerAliveInterval 60
    ServerAliveCountMax 3
    TCPKeepAlive yes

    AddKeysToAgent yes
    # ForwardAgent left off deliberately — enable per trusted host in config.local.
