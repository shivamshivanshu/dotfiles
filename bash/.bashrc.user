# paths
for d in "$HOME/.local/bin" "$HOME/bin" "$HOME/.cargo/bin"; do
  [[ -d "$d" && ":$PATH:" != *":$d:"* ]] && PATH="$d:$PATH"
done
export PATH

export COLORTERM=truecolor

# source modular configs
if [[ -d ~/.bashrc.d ]]; then
  for rc in ~/.bashrc.d/*; do
    [[ -f "$rc" ]] && source "$rc"
  done
  unset rc
fi
